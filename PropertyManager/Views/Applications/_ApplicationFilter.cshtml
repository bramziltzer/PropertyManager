@model ApplicationListFilterViewModel

<form asp-controller="Applications" asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" name="status" asp-items="Model.StatusOptions" class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-md-5">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId" name="propertyId" asp-items="Model.PropertyOptions" class="form-select">
                <option value="">All properties</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a asp-controller="Applications" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>
