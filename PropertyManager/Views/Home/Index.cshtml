@model HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="py-4">
    <div class="mb-4">
        <h1 class="display-6">Property Manager Portal</h1>
        <p class="lead text-muted mb-0">
            Manage rental properties, browse available apartments, and track rental applications.
        </p>
    </div>

    @if (Model.IsPropertyManager || Model.IsApplicant)
    {
        <div class="row g-3">
            @foreach (var card in Model.Cards)
            {
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title">@card.Title</h2>
                            <p class="card-text text-muted flex-grow-1">@card.Description</p>
                            <div>
                                <a class="btn @(card.IsPrimary ? "btn-primary" : "btn-outline-primary")"
                                   asp-controller="@card.Controller"
                                   asp-action="@card.Action">@card.LinkText</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <h2 class="h5 card-title">Get Started</h2>
                <p class="card-text text-muted">
                    Sign in with your account or register as an Applicant or Property Manager to get started.
                </p>
                <div class="d-flex gap-2">
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Log In</a>
                    <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Register">Register</a>
                </div>
            </div>
        </div>
    }
</div>
