@model IReadOnlyList<PropertyListItemViewModel>

@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Properties</h1>
    <button type="button"
            class="btn btn-primary"
            data-modal-url="@Url.Action("Create")">
        Add Property
    </button>
</div>

<div data-refresh-region="properties" data-refresh-url="@Url.Action("List")">
    <partial name="_PropertyList" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
