@model IReadOnlyList<PropertyListItemViewModel>

@if (Model.Count == 0)
{
    <div class="alert alert-info mb-0">
        No properties have been added yet.
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (var item in Model)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-0">@item.Name</h2>
                        <small class="text-muted">@item.FormattedAddress</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                data-modal-url="@Url.Action("Create", "PropertyUnits", new { propertyId = item.PropertyId })">
                            Add Unit
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-modal-url="@Url.Action("Edit", new { propertyId = item.PropertyId })">
                            Edit
                        </button>
                        @if (item.UnitCount > 0)
                        {
                            <span class="d-inline-block"
                                  tabindex="0"
                                  data-bs-toggle="tooltip"
                                  data-bs-placement="top"
                                  title="This property has units and cannot be deleted until they are removed.">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled>
                                    Delete
                                </button>
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    data-modal-url="@Url.Action("Delete", new { propertyId = item.PropertyId })">
                                Delete
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body"
                     data-refresh-region="property-units-@item.PropertyId"
                     data-refresh-url="@Url.Action("List", "PropertyUnits", new { propertyId = item.PropertyId })">
                    @await Component.InvokeAsync("PropertyUnits", new { propertyId = item.PropertyId, units = item.Units })
                </div>
            </div>
        }
    </div>
}
