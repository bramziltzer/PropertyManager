@using PropertyManager.Models.PropertyModels
@model UnitFormViewModel

<form asp-controller="PropertyUnits"
      asp-action="@(Model.IsEdit ? "Edit" : "Create")"
      asp-route-id="@(Model.IsEdit ? Model.RentalUnitId : null)"
      asp-route-propertyId="@(Model.IsEdit ? null : Model.PropertyId)"
      method="post"
      data-modal-form>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PropertyId" />
    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="RentalUnitId" />
    }
    <div class="modal-header">
        <h2 class="modal-title fs-5">@Model.Title</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div data-modal-error class="alert alert-danger d-none" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Kind" class="form-label"></label>
            <select asp-for="Kind" asp-items="Model.UnitTypeOptions" class="form-select"></select>
            <span asp-validation-for="Kind" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" type="number" min="0" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@Model.SubmitLabel</button>
    </div>
</form>
