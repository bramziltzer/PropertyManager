@model ReviewFormViewModel

<form asp-controller="Reviews"
      asp-action="Review"
      asp-route-id="@Model.RentalApplicationId"
      method="post"
      data-modal-form>
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h2 class="modal-title fs-5">Review Application</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div data-modal-error class="alert alert-danger d-none" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <div class="fw-semibold">@Model.PropertyName &mdash; Unit @Model.UnitNumber</div>
            <div class="text-muted small">Applicant: @Model.ApplicantDisplayName</div>
        </div>

        <div class="mb-3">
            <label asp-for="Outcome" class="form-label"></label>
            <select asp-for="Outcome" class="form-select">
                <option value="">-- Select Outcome --</option>
                <option value="@ReviewOutcome.Approve">Approve (Issue 12-Month Lease)</option>
                <option value="@ReviewOutcome.Return">Return to Applicant</option>
                <option value="@ReviewOutcome.Deny">Deny</option>
            </select>
            <span asp-validation-for="Outcome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment"
                      class="form-control"
                      rows="4"
                      placeholder="Required when returning or denying an application."></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit Review</button>
    </div>
</form>
