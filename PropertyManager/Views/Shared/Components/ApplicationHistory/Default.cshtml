@model IReadOnlyList<ApplicationStatusChangeViewModel>

<div class="card">
    <div class="card-header">
        <h2 class="h5 mb-0">Application History</h2>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No status changes have been recorded yet.</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var entry in Model)
                {
                    <div class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="fw-semibold">
                                    @entry.Outcome
                                    <span class="text-muted fw-normal">
                                        (@entry.OldStatus &rarr; @entry.NewStatus)
                                    </span>
                                </div>
                                <div class="small text-muted">
                                    By @entry.ChangedByDisplayName
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Comment))
                                {
                                    <div class="mt-1">@entry.Comment</div>
                                }
                            </div>
                            <div class="small text-muted text-nowrap">
                                @entry.ChangedDate.LocalDateTime.ToString("g")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
