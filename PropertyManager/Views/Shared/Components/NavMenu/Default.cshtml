@model IReadOnlyList<NavMenuItemViewModel>

<ul class="navbar-nav flex-grow-1">
    @foreach (var item in Model)
    {
        <li class="nav-item">
            <a class="nav-link @(item.IsActive ? "active fw-semibold text-primary" : "text-dark")"
               aria-current="@(item.IsActive ? "page" : null)"
               asp-area=""
               asp-controller="@item.Controller"
               asp-action="@item.Action">@item.Title</a>
        </li>
    }
</ul>
