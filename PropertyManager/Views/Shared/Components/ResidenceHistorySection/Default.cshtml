@model ResidenceHistorySectionViewModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Residence History</h2>
    @if (Model.IsEditable)
    {
        <button type="button"
                class="btn btn-sm btn-primary"
                data-modal-url="@Url.Action("Create", "Residences", new { applicationId = Model.RentalApplicationId })">
            Add Residence
        </button>
    }
</div>

@if (Model.Residences.Count == 0)
{
    <p class="text-muted mb-0">No residences have been added yet.</p>
}
else
{
    <div class="vstack gap-3">
        @foreach (var residence in Model.Residences)
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <h3 class="h6 mb-1">@AddressFormatter.Format(residence.Address)</h3>
                            <div class="text-muted">
                                @residence.MoveInDate.ToString("MMMM yyyy")
                                &ndash;
                                @(residence.MoveOutDate?.ToString("MMMM yyyy") ?? "Present")
                            </div>
                            <dl class="row small mt-2 mb-0">
                                <dt class="col-sm-4">Landlord</dt>
                                <dd class="col-sm-8">@residence.LandlordName</dd>
                                <dt class="col-sm-4">Phone</dt>
                                <dd class="col-sm-8">@residence.LandlordPhone</dd>
                            </dl>
                        </div>
                        @if (Model.IsEditable)
                        {
                            <div class="d-flex align-items-start gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        data-modal-url="@Url.Action("Edit", "Residences", new { applicationId = Model.RentalApplicationId, id = residence.ResidenceHistoryId })">
                                    Edit
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-modal-url="@Url.Action("Delete", "Residences", new { applicationId = Model.RentalApplicationId, id = residence.ResidenceHistoryId })">
                                    Delete
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
