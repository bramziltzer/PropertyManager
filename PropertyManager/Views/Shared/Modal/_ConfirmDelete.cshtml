@model ConfirmDeleteViewModel

<form action="@Model.ActionUrl" method="post" data-modal-form>
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h2 class="modal-title fs-5">@Model.Title</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div data-modal-error class="alert alert-danger d-none" role="alert"></div>
        <p>This action cannot be undone.</p>
        @if (!string.IsNullOrWhiteSpace(Model.Detail))
        {
            <p>@Model.Detail</p>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
