@model UnitDetailsViewModel

@{
    ViewData["Title"] = $"Unit {Model.UnitNumber} - {Model.PropertyName}";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-link ps-0">&larr; Back to Available Units</a>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h4 mb-0">@Model.PropertyName &mdash; Unit @Model.UnitNumber</h1>
            <div class="text-muted small">@Model.FormattedAddress</div>
        </div>
        @if (Model.IsAvailable)
        {
            <span class="badge bg-success">Available</span>
        }
        else
        {
            <span class="badge bg-secondary">Unavailable</span>
        }
    </div>
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3">Unit Type</dt>
            <dd class="col-sm-9">@Model.UnitTypeName</dd>

            <dt class="col-sm-3">Bedrooms</dt>
            <dd class="col-sm-9">@Model.Bedrooms</dd>

            <dt class="col-sm-3">Monthly Rent</dt>
            <dd class="col-sm-9">@Model.MonthlyRent.ToString("C")</dd>
        </dl>

        @if (Model.ExistingOpenApplicationId.HasValue)
        {
            <div class="alert alert-info mb-0">
                You already have an open application for this unit.
                <a asp-controller="Applications" asp-action="Edit" asp-route-id="@Model.ExistingOpenApplicationId.Value" class="alert-link">
                    Continue application
                </a>
            </div>
        }
        else if (Model.IsAvailable)
        {
            <form asp-action="Start" asp-route-unitId="@Model.RentalUnitId" method="post">
                <button type="submit" class="btn btn-primary">Start Application</button>
            </form>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                This unit currently has an active lease and is not available for application.
            </div>
        }
    </div>
</div>
