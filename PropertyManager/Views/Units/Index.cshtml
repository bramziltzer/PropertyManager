@model AvailableUnitsListViewModel

@{
    ViewData["Title"] = "Available Units";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Available Units</h1>
</div>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="PropertyId" class="form-label"></label>
            <select asp-for="PropertyId" asp-items="Model.PropertyFilterOptions" class="form-select">
                <option value="">All properties</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" type="number" min="0" class="form-control" placeholder="Any" />
        </div>
        <div class="col-md-3">
            <label asp-for="MaxRent" class="form-label"></label>
            <input asp-for="MaxRent" type="number" min="0" step="0.01" class="form-control" placeholder="No max" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.Units.Count == 0)
{
    <div class="alert alert-info">
        No available units match the current filters.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Property</th>
                    <th>Unit</th>
                    <th>Type</th>
                    <th>Bedrooms</th>
                    <th>Monthly Rent</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@unit.PropertyName</div>
                            <div class="text-muted small">@unit.FormattedAddress</div>
                        </td>
                        <td>@unit.UnitNumber</td>
                        <td>@unit.UnitTypeName</td>
                        <td>@unit.Bedrooms</td>
                        <td>@unit.MonthlyRent.ToString("C")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@unit.RentalUnitId" class="btn btn-sm btn-outline-primary">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
